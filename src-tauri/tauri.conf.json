{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cli-companion",
  "version": "0.9.0",
  "identifier": "com.jmagarelli.cli-companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "cli-companion",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGNUVDQUYwQjlBMUE0RUMKUldUc3BLRzU4TXBlSDVQNlU1UGM3NXg4THVNWldoclc4SmZmODBUUTBVYmJGR3ZITHFXRFVSUFcK",
      "endpoints": ["https://github.com/necos98/cli-companion/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
